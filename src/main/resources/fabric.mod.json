{
  "schemaVersion": 1,
  "id": "wurst",
  "version": "${version}",
  "name": "SKILLMASK Client",
  "description": "Переделал: SKILLMASK",
  "authors": [
    "SKILLMASK"
  ],
  "contact": {
    "homepage": "https://wurstclient.net",
    "sources": "https://wurstclient.net",
    "issues": "https://wurstclient.net"
  },
  "license": "GPL-3.0-or-later",
  "icon": "assets/wurst/icon.png",
