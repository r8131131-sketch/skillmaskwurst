    },
    "modmenu": {
      "links": {
        "modmenu.donate": "https://wurstclient.net",
        "modmenu.twitter": "https://wurstclient.net",
        "modmenu.wiki": "https://wurstclient.net",
        "Forum": "https://wurstclient.net"
      }
